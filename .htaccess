DirectoryIndex index.html index.php
RewriteEngine On
AddDefaultCharset UTF-8

# ---------- 1. KANONISIERUNG: index / index.html -> / ----------
RewriteCond %{THE_REQUEST} \s/index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index(?!\.) [NC]
RewriteRule ^index$ / [R=301,L]

# ---------- 2. NEWS: Alte / Falsche URLs auf kanonisch /news/ 301 umleiten ----------
#    Die News-Seite liegt jetzt strukturell richtig als /news/index.html vor!
#    Apache liefert sie automatisch als DirectoryIndex aus, wenn /news/ aufgerufen wird.
#
# a) Alte /news.html (im Root) -> /news/
RewriteCond %{THE_REQUEST} \s/+news\.html(?:\s|\?) [NC]
RewriteRule ^news\.html$ /news/ [R=301,L]
#
# b) Alte Duplikat-URLs /news/news* -> /news/ (Google hat das früher indexiert!)
RewriteCond %{THE_REQUEST} \s/+news/news [NC]
RewriteRule ^news/news(?:\.html)?/?$ /news/ [R=301,L]

# ---------- 3. GENERISCH: .html-Endung aus URLs entfernen (301) ----------
#     Nur wenn KEIN News-Sonderfall (News wird oben schon behandelt)
RewriteCond %{REQUEST_URI} !^/news\.html$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.+?)\.html(?:\s|\?) [NC]
RewriteRule ^ %1 [R=301,L]

# ---------- 4. INTERN: Schöne URL -> passende .html-Datei suchen ----------
#    NUR wenn: KEIN echter Ordner, KEINE echte Datei, .html EXISTIERT wirklich!
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.*?)/?$ %{REQUEST_URI}.html [L,NS]

# Alternativ: Pfad endet auf / (z.B. "/verein/") -> /verein.html im Root suchen
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)/$ /$1.html [L,NS]

# Statisches Asset-Caching fuer bessere Wiederholungsaufrufe
<IfModule mod_expires.c>
	ExpiresActive On

	ExpiresByType text/css "access plus 1 month"
	ExpiresByType text/javascript "access plus 1 month"
	ExpiresByType application/javascript "access plus 1 month"
	ExpiresByType application/json "access plus 7 days"

	ExpiresByType image/avif "access plus 6 months"
	ExpiresByType image/webp "access plus 6 months"
	ExpiresByType image/jpeg "access plus 6 months"
	ExpiresByType image/png "access plus 6 months"
	ExpiresByType image/gif "access plus 6 months"
	ExpiresByType image/svg+xml "access plus 6 months"

	ExpiresByType font/woff2 "access plus 6 months"
	ExpiresByType font/woff "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.(css|js)$">
		Header set Cache-Control "public, max-age=2592000, immutable"
	</FilesMatch>

	<FilesMatch "\.(avif|webp|jpg|jpeg|png|gif|svg|woff2?|ico)$">
		Header set Cache-Control "public, max-age=15552000, immutable"
	</FilesMatch>

	<FilesMatch "\.(json)$">
		Header set Cache-Control "public, max-age=604800"
	</FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
