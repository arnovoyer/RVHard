# ================================================================
#   SBS GALERIE – ADMIN SICHERHEIT (.htaccess)
#   KEIN Basic Auth mehr! → Login über PHP Session login.php
#   Hier nur noch: Schutz vor Directory Listing + HTTPS erzwingen
# ================================================================

DirectoryIndex index.php index.html

Options -Indexes -MultiViews

# ---------- HTTPS erzwingen (All-Inkl unterstützt X-Forwarded-Proto) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------- Keine .ht* / config Dateien von außen erreichbar ----------
# (generate-password-hash.php ABSICHTLICH NICHT gesperrt, da er kurz zum
#  Generieren eines neuen Passwort-Hashes aufgerufen werden muss.
#  ABER: nach Gebrauch SOFORT vom Server löschen! Steht in der Anleitung!)
<FilesMatch "^\.ht|^config(\.example)?\.php$|^auth\.php$">
  Require all denied
</FilesMatch>

# ---------- NUR PHP SCRIPTE ALS ADMIN-SEITEN erlauben (kein HTML ohne Auth!) ----------
# ACHTUNG: Kommentiere diese Zeile AUS wenn du index.html temporär ohne Login testen willst!
<FilesMatch "\.html$">
  Require all denied
</FilesMatch>
