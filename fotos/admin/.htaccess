# ================================================================
#   SBS GALERIE – ADMIN SICHERHEIT (.htaccess)
#   KEIN Basic Auth mehr! → Login über PHP Session login.php
# ================================================================

DirectoryIndex index.php index.html

Options -Indexes -MultiViews

# ---------- HTTPS erzwingen: nur bei 302 (Temporär!), damit kein Cache-Loop! ----------
# (R=302 statt R=301, und erstellen wir NUR weiterleitung wenn es wirklich KEIN https ist.
#  Bei Reverse Proxy / CDN wird HTTPS oft vor dem Server beendet → X-Forwarded-Proto checken!)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP:X-Forwarded-Ssl} !on [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
</IfModule>

# ---------- Keine .ht* / config Dateien von außen erreichbar ----------
<FilesMatch "^\.ht|^config(\.example)?\.php$|^auth\.php$">
  Require all denied
</FilesMatch>

# ---------- _debug-check.php auch von außen erlauben (kurz zur Fehleranalyse!) ----------
<FilesMatch "^_debug-check\.php$">
  Require all granted
</FilesMatch>

# ---------- NUR PHP SCRIPTE ALS ADMIN-SEITEN erlauben ----------
<FilesMatch "\.html$">
  Require all denied
</FilesMatch>
