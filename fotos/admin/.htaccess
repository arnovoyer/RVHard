# ================================================================
#   SBS GALERIE – ADMIN SICHERHEIT (.htaccess)
#   MINDEST KONFIGURATION – KEINE REWRITES, KEINE HTTPS-UMLEITUNG!
#   (HTTPS wird bereits über Subdomain / CDN erzwungen → sonst Loop-Gefahr!)
#   ACHTUNG: Wenn Du eine Zeile änderst, danach Browser-Cache LEEREN!
# ================================================================

# Standard: Index-Dateien
DirectoryIndex index.php index.html

# Keine Verzeichnisauflistung, keine Wildcard-MultiViews
Options -Indexes -MultiViews

# Kein Zugriff auf .ht* Dateien, config/auth (internal)
<FilesMatch "^\.ht|^config(\.example)?\.php$|^auth\.php$|^auth2\.php$">
  Require all denied
</FilesMatch>

# Debug und Passwort-Generator: kurzfristig erlaubt, nach Gebrauch LÖSCHEN!
<FilesMatch "^(_debug-check|generate-password-hash)\.php$">
  Require all granted
</FilesMatch>

# HTML im Admin ggf. sperren (wir nutzen nur index.php!)
<FilesMatch "\.html$">
  Require all denied
</FilesMatch>

# =================================================================
#  HTTPS UMLEITUNG - VORSICHT AKTIVIERT!
#  Wenn du sicher bist, dass es KEINEN Reverse Proxy Loop gibt:
#  Entferne die # vor RewriteEngine/RewriteCond/RewriteRule.
#  NUTZE R=302 (temporär!) – R=301 wird für IMMER im Browser gespeichert!
# =================================================================
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteCond %{HTTPS} !=on
#  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
#  RewriteCond %{HTTP:X-Forwarded-Ssl} !on [NC]
#  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
#</IfModule>
